APP_NAME="DiaMate-RAG"
APP_VERSION="1.0"
ALLOWED_FILE_TYPES=["text/plain", "application/pdf"]
MAX_FILE_SIZE=50
FILE_DEFAULT_CHUNK_SIZE=1024000

# Provider selection: google | openai | openrouter | ollama | cohere
EMBEDDING_PROVIDER="ollama"
LLM_PROVIDER="google"
RERANKING_PROVIDER: str = "cohere"

# Provider API keys
GOOGLE_API_KEY=""
OPENAI_API_KEY=""
COHERE_API_KEY: str = ""
OPENROUTER_API_KEY=""

# Ollama
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_EMBED_BATCH_SIZE=1

# Model overrides (blank = use provider default)
EMBEDDING_MODEL=""
LLM_MODEL=""
RERANKING_MODEL: str = ""

# Qdrant
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="diamate"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_CHAT_TTL=86400

OLLAMA_HOST=ollama
