APP_NAME="DiaMate-RAG"
APP_VERSION="1.0"
ALLOWED_FILE_TYPES=["text/plain", "application/pdf"]
MAX_FILE_SIZE=50
FILE_DEFAULT_CHUNK_SIZE=1024000

# Provider selection: google | openai | openrouter | ollama
EMBEDDING_PROVIDER="google"
LLM_PROVIDER="google"

# Provider API keys
GOOGLE_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""

# Ollama
OLLAMA_BASE_URL="http://localhost:11434"

# Model overrides (blank = use provider default)
EMBEDDING_MODEL=""
LLM_MODEL=""

# Qdrant
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="diamate"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_CHAT_TTL=86400